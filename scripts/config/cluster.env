# =============================================================================
#  HomeLab -- Cluster Configuration
#  Editar este archivo antes de ejecutar bootstrap.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Red — IPs definitivas (VLAN 20, cuando pfSense esté activo)
# -----------------------------------------------------------------------------
CP_IP_FINAL="10.10.20.101"          # Dell 7490 #1 — control-plane temporal
CP_IP_PERMANENT="10.10.20.100"      # Dell 5480   — control-plane permanente (llega después)
WORKER1_IP="10.10.20.102"           # Dell 7490 #2
WORKER2_IP="10.10.20.103"           # P52 — ML/GPU (llega después)
WORKER3_IP="10.10.20.104"           # T440p — storage

# IPs WiFi temporales (192.168.1.x — mientras pfSense esté apagado)
CP_IP_WIFI="192.168.1.139"
WORKER1_IP_WIFI="192.168.1.141"
WORKER3_IP_WIFI="192.168.1.89"

# -----------------------------------------------------------------------------
# K3s
# -----------------------------------------------------------------------------
K3S_VERSION=""                      # vacío = latest stable
CLUSTER_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"
DISABLE_COMPONENTS="traefik servicelb"

# TLS SANs — todas las IPs que el API server debe aceptar
TLS_SANS=(
  "10.10.20.100"
  "10.10.20.101"
  "192.168.1.139"
)

# -----------------------------------------------------------------------------
# Cilium
# -----------------------------------------------------------------------------
CILIUM_VERSION=""                   # vacío = latest stable
HUBBLE_ENABLED=true
HUBBLE_UI_ENABLED=true
KUBE_PROXY_REPLACEMENT=true

# -----------------------------------------------------------------------------
# Longhorn
# -----------------------------------------------------------------------------
LONGHORN_VERSION=""                 # vacío = latest stable
LONGHORN_NAMESPACE="longhorn-system"
LONGHORN_STORAGE_CLASS="longhorn"
LONGHORN_REPLICA_COUNT=2
LONGHORN_DATA_PATH="/var/lib/longhorn"
LONGHORN_NVMe_PATH="/mnt/nvme-longhorn"   # P52 — tier NVMe (cuando llegue)

# -----------------------------------------------------------------------------
# ArgoCD
# -----------------------------------------------------------------------------
ARGOCD_VERSION=""                   # vacío = latest stable
ARGOCD_NAMESPACE="argocd"
ARGOCD_REPO_URL=""                  # tu repo GitOps
ARGOCD_BRANCH="main"

# -----------------------------------------------------------------------------
# Usuarios y paths
# -----------------------------------------------------------------------------
ADMIN_USER="admin"
ADMIN_HOME="/home/admin"
SCRIPTS_DIR="${ADMIN_HOME}/Documents/Personal/HomeLab/scripts"
KUBECONFIG_PATH="${ADMIN_HOME}/.kube/config"
