# =============================================================================
#  HomeLab -- Cluster Configuration  v1.1
#  Editar este archivo antes de ejecutar bootstrap.sh
#  Actualizado: Junio 2026 — Sesión II
# =============================================================================

# -----------------------------------------------------------------------------
# Red — IPs definitivas (VLAN 20, cuando pfSense esté activo)
# -----------------------------------------------------------------------------
CP_IP_FINAL="10.10.20.101"          # Dell 7490 #1 — control-plane temporal
CP_IP_PERMANENT="10.10.20.100"      # Dell 5480   — control-plane permanente (llega después)
WORKER1_IP="10.10.20.102"           # Dell 7490 #2
WORKER2_IP="10.10.20.103"           # P52 — ML/GPU (llega después)
WORKER3_IP="10.10.20.104"           # T440p — storage

# IPs WiFi temporales (192.168.1.x — mientras pfSense esté apagado)
CP_IP_WIFI="192.168.1.139"
WORKER1_IP_WIFI="192.168.1.141"
WORKER3_IP_WIFI="192.168.1.89"

# -----------------------------------------------------------------------------
# K3s
# -----------------------------------------------------------------------------
K3S_VERSION=""                      # vacío = latest stable
CLUSTER_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"
DISABLE_COMPONENTS="traefik servicelb"

# TLS SANs — todas las IPs que el API server debe aceptar
TLS_SANS=(
  "10.10.20.100"
  "10.10.20.101"
  "192.168.1.139"
)

# -----------------------------------------------------------------------------
# Cilium
# -----------------------------------------------------------------------------
CILIUM_VERSION=""                   # vacío = latest stable
HUBBLE_ENABLED=true
HUBBLE_UI_ENABLED=true
KUBE_PROXY_REPLACEMENT=true

# -----------------------------------------------------------------------------
# Longhorn
# -----------------------------------------------------------------------------
LONGHORN_VERSION=""                 # vacío = latest stable
LONGHORN_NAMESPACE="longhorn-system"
LONGHORN_STORAGE_CLASS="longhorn"
LONGHORN_REPLICA_COUNT=2
LONGHORN_DATA_PATH="/var/lib/longhorn"
LONGHORN_NVMe_PATH="/mnt/nvme-longhorn"   # P52 — tier NVMe (cuando llegue)

# -----------------------------------------------------------------------------
# ArgoCD
# -----------------------------------------------------------------------------
ARGOCD_VERSION=""                   # vacío = latest stable
ARGOCD_NAMESPACE="argocd"
ARGOCD_REPO_URL=""                  # tu repo GitOps
ARGOCD_BRANCH="refactor/full-gitops-bootstrap"   # Cambiar a "main" al hacer merge

# -----------------------------------------------------------------------------
# Usuarios y paths
# -----------------------------------------------------------------------------
ADMIN_USER="admin"
ADMIN_HOME="/home/admin"
SCRIPTS_DIR="${ADMIN_HOME}/Documents/Personal/HomeLab/scripts"
KUBECONFIG_PATH="${ADMIN_HOME}/.kube/config"

# =============================================================================
# Vault
# =============================================================================
VAULT_NAMESPACE="vault"
VAULT_VERSION=""                    # vacío = latest stable
VAULT_MODE="dev"                    # dev | prod
VAULT_DEV_ROOT_TOKEN="homelab-root" # solo dev mode
VAULT_HOST="vault.lab.internal"

# =============================================================================
# Jenkins
# =============================================================================
JENKINS_NAMESPACE="ci-cd"
JENKINS_VERSION=""
JENKINS_PVC_SIZE="20Gi"
JENKINS_NODEPORT="32000"
JENKINS_HOST="jenkins.lab.internal"

# =============================================================================
# Control-M
# =============================================================================
CONTROLM_NAMESPACE="workload-automation"
CONTROLM_PVC_SIZE="50Gi"
CONTROLM_HOST="controlm.lab.internal"

# =============================================================================
# AWX (Ansible Tower)
# =============================================================================
AWX_NAMESPACE="awx"
AWX_OPERATOR_VERSION=""             # vacío = latest
AWX_PVC_SIZE="20Gi"
AWX_HOST="awx.lab.internal"

# =============================================================================
# Ingress — Nginx
# =============================================================================
INGRESS_NAMESPACE="ingress-nginx"
INGRESS_VERSION=""

# Hostnames internos — agregar a AdGuard DNS rewrites o /etc/hosts
ARGOCD_HOST="argocd.lab.internal"
LONGHORN_HOST="longhorn.lab.internal"
HUBBLE_HOST="hubble.lab.internal"
GRAFANA_HOST="grafana.lab.internal"

# =============================================================================
# Databases (namespace: databases)
# =============================================================================
DB_NAMESPACE="databases"
DB_PVC_SIZE="10Gi"              # tamaño PVC por base de datos
DB_REDIS_PVC_SIZE="5Gi"         # Redis usa menos espacio

# Connection strings — recuperar de Vault:
#   secret/databases/postgresql
#   secret/databases/redis
#   secret/databases/mongodb
# Hosts internos:
#   postgresql.databases.svc.cluster.local:5432
#   redis-master.databases.svc.cluster.local:6379
#   mongodb.databases.svc.cluster.local:27017

# =============================================================================
# Argo Workflows (equivalente Control-M)
# =============================================================================
ARGO_WORKFLOWS_NS="workload-automation"   # mismo namespace que Control-M
ARGO_WORKFLOWS_NODEPORT="30888"
ARGO_WORKFLOWS_HOST="workflows.lab.internal"
# Archive: postgresql.databases.svc.cluster.local:5432/homelab
# Credenciales: secret/databases/postgresql en Vault
